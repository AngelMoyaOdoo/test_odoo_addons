<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_competitor_form" model="ir.ui.view">
        <field name="name">crm.lead.competitor.form</field>
        <field name="model">crm.lead.competitor</field>
        <field name="arch" type="xml">
            <form string="Competitor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="website" widget="url"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_competitor_tree" model="ir.ui.view">
        <field name="name">crm.lead.competitor.tree</field>
        <field name="model">crm.lead.competitor</field>
        <field name="arch" type="xml">
            <tree string="Competitors">
                <field name="name"/>
                <field name="website"/>
            </tree>
        </field>
    </record>

    <record id="action_crm_competitor" model="ir.actions.act_window">
        <field name="name">Competitors</field>
        <field name="res_model">crm.lead.competitor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new competitor
          </p>
        </field>
    </record>

    <menuitem id="menu_crm_config_competitor"
              parent="crm.crm_menu_config"
              action="action_crm_competitor"
              sequence="20"/>
</odoo>
